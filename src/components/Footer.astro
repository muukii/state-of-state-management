---
import { Snowflake } from 'lucide-react';
---

<footer class="border-t border-border/40 mt-16">
  <div class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-between">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <Snowflake className="h-4 w-4" strokeWidth={1.8} aria-hidden="true" />
        <span>State of State Management</span>
      </div>
      <p class="text-sm text-muted-foreground">
        by <a href="https://github.com/muukii" class="font-medium text-foreground underline-offset-4 hover:underline">muukii</a>
      </p>
    </div>
  </div>
</footer>
