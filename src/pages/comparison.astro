---
import DocsLayout from '../layouts/DocsLayout.astro';
import { Code } from 'astro:components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vergeDoubledCode = `// Verge — store-centric, explicit derived
let store = Store<MyState, Never>(initialState: .init())

let doubled = store.derived(.map(\\.count).map { $0 * 2 })

store.commit { $0.count = 5 }
// doubled emits 10 to subscribers`;

const tcaDoubledCode = `// TCA — store-centric, computed property on State
@Reducer
struct Feature {
  @ObservableState
  struct State: Equatable {
    var count = 0
    var doubled: Int { count * 2 }  // plain computed
  }

  enum Action { case increment }

  var body: some ReducerOf<Self> {
    Reduce { state, action in
      switch action {
      case .increment:
        state.count += 1
        return .none
      }
    }
  }
}`;

const atomsDoubledCode = `// Atoms — atomic graph
struct CountAtom: StateAtom, Hashable {
  func defaultValue(context: Context) -> Int { 0 }
}

struct DoubledAtom: ValueAtom, Hashable {
  func value(context: Context) -> Int {
    context.watch(CountAtom()) * 2  // auto-tracked graph edge
  }
}`;

const zustandDoubledCode = `// Zustand — store-centric, selector-based
const useStore = create((set) => ({
  count: 0,
  increment: () => set((s) => ({ count: s.count + 1 })),
}));

// Derived via selector (no graph)
function Doubled() {
  const doubled = useStore((s) => s.count * 2);
  return <span>{doubled}</span>;
}`;

const tanstackDoubledCode = `// TanStack Store — signals-style graph
const countStore = createStore(0);

const doubled = createStore(() => countStore.state * 2);

countStore.setState(() => 5);
console.log(doubled.state); // 10`;

const jotaiDoubledCode = `// Jotai — atom graph, auto-tracked
const countAtom = atom(0);

const doubledAtom = atom((get) => get(countAtom) * 2);
// dependency on countAtom registered via get()`;

const ssgDoubledCode = `// swift-state-graph — DAG-based graph
final class MyGraph: GraphObject {
  @GraphStored var count: Int = 0

  @GraphComputed var doubled: Int

  init() {
    $doubled = .init { [$count] _ in
      $count.wrappedValue * 2
    }
  }
}`;

const composeDoubledCode = `// Compose derivedStateOf — Snapshot graph
@Composable
fun DoubledDisplay(viewModel: MyViewModel) {
  val count by viewModel.count.collectAsState()

  val doubled by remember {
    derivedStateOf { count * 2 }
  }

  Text("Doubled: $doubled")
}`;

const riverpodDoubledCode = `// Riverpod — provider graph
final countProvider = StateProvider((ref) => 0);

final doubledProvider = Provider((ref) {
  final count = ref.watch(countProvider);
  return count * 2;  // ref.watch() auto-registers dependency
});`;
---

<DocsLayout
