---
interface Props {
  title: string;
  description: string;
  currentPath: string;
}

import '../styles/global.css';
import { buildDateIso } from '../lib/build-info';

const { title, description, currentPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://muukii.github.io');
const canonicalUrl = new URL(currentPath, site).toString();
const favicon = `${base}/favicon.svg`;
const ogImageUrl = new URL(`${base}/og.svg`, site).toString();
const siteName = 'State of State Management';
const repoUrl = 'https://github.com/muukii/state-of-state-management';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  dateModified: buildDateIso,
  author: {
    '@type': 'Person',
    name: 'muukii',
    url: 'https://github.com/muukii',
  },
  publisher: {
    '@type': 'Person',
    name: 'muukii',
    url: 'https://github.com/muukii',
  },
  sameAs: [repoUrl],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="muukii" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="State of State Management" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
        document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <slot />
  </body>
</html>
